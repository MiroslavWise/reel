# Username of the bot without the @ symbol. Exposed to the login widget.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# Keep both values secret. Set them in Vercel Project Settings -> Environment Variables.
TELEGRAM_BOT_TOKEN=123456789:your_bot_token
AUTH_SESSION_SECRET=replace_with_a_long_random_secret

# Canonical production URL.
NEXT_APP_SITE_URL=https://reel-mocha.vercel.app/